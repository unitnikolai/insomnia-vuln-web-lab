# generated attack-box password — never commit this
.env

# your own binaries/scripts dropped in for the attack box — keep the repo
# reproducible, not a binary dump; ship these separately (scp) per deploy
tools/*
!tools/.gitkeep

# stray local clones if someone runs the crAPI/Vulhub steps inside this folder
crAPI/
vulhub/

# tracks which vulhub recipe(s) are active, so down.sh/status.sh can find them
.vulhub-active
.vulhub-all-active
.vulhub-all-failures

# gate service — installed in its Docker build, not needed in the repo
gate/node_modules/
