<%- include('partials/nav', { title: 'Upload scan' }) %>

<h1>Upload a scan export</h1>
<p class="subtitle">
  Accepts any JSON export. The parser recognizes a few common shapes
  (a bare findings array, <span class="mono">findings</span>/<span class="mono">vulnerabilities</span>/<span class="mono">results</span>/<span class="mono">alerts</span>
  wrapper keys, and OWASP ZAP's <span class="mono">site[].alerts[]</span> nesting) — anything else is still stored in full,
  just without parsed findings, so nothing is lost while the real export format gets nailed down.
</p>

<% if (error) { %><div class="error-box"><%= error %></div><% } %>

<form class="upload" method="post" action="/upload" enctype="multipart/form-data">
  <label for="scanFile">Scan JSON file</label>
  <input type="file" id="scanFile" name="scanFile" accept="application/json,.json" required>

  <label for="lab_id">Lab / Vulhub recipe this scan targeted</label>
  <select id="lab_id" name="lab_id">
    <option value="">— unspecified / mixed —</option>
    <% labs.forEach(l => { %>
      <option value="<%= l.id %>"><%= l.name %> (<%= l.kind %>)</option>
    <% }) %>
  </select>

  <label for="tool_name">Scanner / tool name</label>
  <input type="text" id="tool_name" name="tool_name" placeholder="e.g. Nuclei, ZAP, Nessus">

  <label for="uploaded_by">Uploaded by</label>
  <input type="text" id="uploaded_by" name="uploaded_by" placeholder="optional">

  <label for="notes">Notes</label>
  <textarea id="notes" name="notes" placeholder="optional"></textarea>

  <button type="submit">Upload &amp; score</button>
</form>

<%- include('partials/foot') %>
